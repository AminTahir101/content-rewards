generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CREATOR
  BRAND
  AGENCY
  ADMIN
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationType {
  BRAND
  AGENCY
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CREATOR)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  creatorProfile      CreatorProfile?
  organizationMembers OrganizationMember[]

  @@map("users")
}

// ─── Auth.js tables ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Profiles ────────────────────────────────────────────────────────────────

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  bio         String?  @db.Text
  avatarUrl   String?
  country     String?  @default("SA")
  city        String?
  language    String?  @default("ar")
  phone       String?
  website     String?
  isComplete  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model CreatorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  handle            String?  @unique
  niche             String[]
  totalFollowers    Int      @default(0)
  verifiedFollowers Int      @default(0)
  score             Int      @default(0)
  isVerified        Boolean  @default(false)
  isEligible        Boolean  @default(true)
  isSuspended       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

// ─── Organizations ───────────────────────────────────────────────────────────

model Organization {
  id         String           @id @default(uuid())
  name       String
  slug       String           @unique
  type       OrganizationType @default(BRAND)
  logoUrl    String?
  website    String?
  country    String?          @default("SA")
  vatNumber  String?
  isVerified Boolean          @default(false)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  members      OrganizationMember[]
  brandProfile BrandProfile?
  campaigns    Campaign[]

  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)
  isActive       Boolean                @default(true)
  joinedAt       DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model BrandProfile {
  id             String   @id @default(uuid())
  organizationId String   @unique
  industry       String?
  description    String?  @db.Text
  totalSpend     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

// ─── Campaigns ───────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RewardModel {
  CPM
  CPV
  CPA
  FIXED
  HYBRID
  MILESTONE
}

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  X
}

enum CampaignCategory {
  LIFESTYLE
  ENTERTAINMENT
  GAMING
  TECHNOLOGY
  FOOD
  FASHION
  BEAUTY
  TRAVEL
  SPORTS
  EDUCATION
  FINANCE
  OTHER
}

model Campaign {
  id                 String           @id @default(uuid())
  organizationId     String
  name               String
  slug               String           @unique
  coverUrl           String?
  description        String?          @db.Text
  objective          String?          @db.Text
  category           CampaignCategory @default(OTHER)
  status             CampaignStatus   @default(DRAFT)
  rewardModel        RewardModel      @default(CPM)
  cpm                Decimal?         @db.Decimal(10, 4)
  minPayout          Decimal          @default(0) @db.Decimal(10, 2)
  maxCreatorPayout   Decimal?         @db.Decimal(10, 2)
  totalBudget        Decimal          @default(0) @db.Decimal(14, 2)
  reservedBudget     Decimal          @default(0) @db.Decimal(14, 2)
  settledBudget      Decimal          @default(0) @db.Decimal(14, 2)
  maxSubmissions     Int?
  countries          String[]         @default(["SA"])
  languages          String[]         @default(["ar"])
  minFollowers       Int              @default(0)
  requiredHashtags   String[]
  requiredMentions   String[]
  contentBrief       String?          @db.Text
  contentDos         String[]
  contentDonts       String[]
  startDate          DateTime?
  endDate            DateTime?
  participantCount   Int              @default(0)
  submissionCount    Int              @default(0)
  verifiedViews      BigInt           @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  platforms    CampaignPlatform[]
  participants CampaignParticipant[]
  submissions  Submission[]

  @@index([status, createdAt])
  @@index([organizationId])
  @@map("campaigns")
}

model CampaignPlatform {
  id         String         @id @default(uuid())
  campaignId String
  platform   SocialPlatform

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, platform])
  @@map("campaign_platforms")
}

model CampaignParticipant {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  joinedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_participants")
}

// ─── Submissions ──────────────────────────────────────────────────────────────

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  VERIFYING
  PENDING_REVIEW
  APPROVED
  TRACKING
  PERFORMANCE_LOCKED
  PAYOUT_PENDING
  PAID
  REJECTED
  FLAGGED
  DISPUTED
  PAYMENT_HOLD
}

model Submission {
  id           String           @id @default(uuid())
  campaignId   String
  userId       String
  contentUrl   String
  platform     SocialPlatform
  status       SubmissionStatus @default(SUBMITTED)
  rejectionReason String?      @db.Text
  earnedAmount Decimal?         @db.Decimal(14, 2)
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  updatedAt    DateTime         @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([campaignId])
  @@index([userId, campaignId])
  @@map("submissions")
}

// ─── Wallet / Ledger ─────────────────────────────────────────────────────────

enum WalletTransactionType {
  CAMPAIGN_REWARD
  WITHDRAWAL
  REFUND
  PLATFORM_FEE
  ADJUSTMENT
  BONUS
  REFERRAL
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  SETTLED
  FAILED
  REVERSED
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  currency         String   @default("SAR")
  // Derived balances — kept in sync transactionally, never mutated directly
  totalEarned      Decimal  @default(0) @db.Decimal(14, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(14, 2)
  availableBalance Decimal  @default(0) @db.Decimal(14, 2)
  lifetimePaid     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                     @id @default(uuid())
  walletId      String
  userId        String
  type          WalletTransactionType
  direction     WalletTransactionDirection
  status        WalletTransactionStatus    @default(PENDING)
  amount        Decimal                    @db.Decimal(14, 2)
  currency      String                     @default("SAR")
  // What triggered this transaction
  referenceType String?                    // e.g. "submission", "withdrawal"
  referenceId   String?                    // e.g. submission.id
  description   String?
  // Snapshot of balance after this transaction (for audit)
  balanceAfter  Decimal?                   @db.Decimal(14, 2)
  createdAt     DateTime                   @default(now())
  settledAt     DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}
